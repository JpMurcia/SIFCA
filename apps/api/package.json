{
  "name": "@sifca/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:arch": "vitest run --project architecture",
    "test:acceptance": "NODE_OPTIONS=--import=tsx cucumber-js --config cucumber.mjs",
    "test:perf": "vitest run --project performance",
    "prisma:generate": "prisma generate",
    "seed:test-chart": "tsx prisma/seed-test-chart.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sifca/contracts": "workspace:*",
    "decimal.js": "10.6.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@nestjs/testing": "12.1.3",
    "@sifca/config": "workspace:*",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "openapi-types": "12.1.3",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "yaml": "2.8.2"
  }
}
